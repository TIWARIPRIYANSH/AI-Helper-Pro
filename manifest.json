{
  "manifest_version": 3,
  "name": "AI Helper Pro",
  "version": "2.2",
  "description": "Extracts content to get answers with a hotkey.",
  "permissions": [
    "activeTab",
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "*://generativelanguage.googleapis.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "lib/tesseract.min.js",
        "content.js"
      ],
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/worker.min.js",
        "lib/eng.traineddata"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "commands": {
    "find_answer_shortcut": {
      "suggested_key": {
        "default": "Ctrl+Shift+A"
      },
      "description": "Find the answer for the current question"
    }
  }
}